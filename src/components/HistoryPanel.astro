	class="panel history-panel hidden"
	aria-labelledby="history-title"
>
	<div class="section-heading">
		<div>
			<span class="step-label">HISTORIAL LOCAL</span><h2
				id="history-title"
			>
				Tus exámenes realizados
			</h2>
