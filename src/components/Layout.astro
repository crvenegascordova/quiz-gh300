---
import "../styles/global.css";
import type { Question } from "../types/question";
import type { CertificationMeta } from "../types/certification";

interface Props {
	title?: string;
	description?: string;
	certifications: CertificationMeta[];
	questionsByCert: Record<string, Question[]>;
}

const {
	title = "Práctica de Certificaciones Técnicas",
	description = "Simulacros de práctica interactivos con justificación oficial y métricas de cobertura.",
	certifications,
	questionsByCert,
} = Astro.props;

const serializedPayload = JSON.stringify({
	certifications,
	questionsByCert,
});
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<main class="app-shell">
			<slot />
		</main>
		<script
			type="application/json"
			id="quiz-platform-data"
			set:html={serializedPayload}
		/>
		<script>
			import { initQuizPlatform } from "../scripts/quiz-client";

			const dataElement = document.getElementById("quiz-platform-data");
			const payload = JSON.parse(dataElement?.textContent ?? "{}");
			initQuizPlatform(payload.certifications ?? [], payload.questionsByCert ?? {});
		</script>
	</body>
</html>
