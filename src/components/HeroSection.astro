---
interface Props {
	title?: string;
	description?: string;
	badge?: string;
}

const {
	title = "Práctica de Certificaciones Técnicas",
	description = "Evalúa tu nivel profesional mediante exámenes de práctica, retroalimentación y criterios de evaluación oficiales.",
	badge = "PLATAFORMA DE CERTIFICACIONES",
} = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
	<div id="hero-eyebrow" class="eyebrow">{badge}</div>
	<h1 id="page-title">{title}</h1>
	<p id="hero-description" class="hero-copy">{description}</p>
</section>

<div class="hero-actions">
	<button
		id="change-cert-btn"
		class="button button-secondary hidden hero-btn"
		type="button"
		title="Volver a la selección de certificaciones"
	>
		<span class="btn-text-full">← Cambiar certificación</span>
		<span class="btn-text-short">← Cambiar</span>
	</button>
	<button
		id="history-button"
		class="button button-secondary hidden hero-btn"
		type="button"
		aria-expanded="false"
	>
		<span class="btn-text-full">Ver mis exámenes</span>
		<span class="btn-text-short">Historial</span>
		<span id="history-arrow" class="history-arrow">↓</span>
	</button>
	<button
		id="study-guide-btn"
		class="button button-secondary hidden hero-btn"
		type="button"
		aria-haspopup="dialog"
	>
		<span class="btn-text-full" id="study-guide-btn-full">Guía oficial de estudio</span>
		<span class="btn-text-short" id="study-guide-btn-short">Guía oficial</span>
	</button>
</div>
