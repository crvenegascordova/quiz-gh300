---
import Layout from "../components/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import CertificationSelector from "../components/CertificationSelector.astro";
import HistoryPanel from "../components/HistoryPanel.astro";
import SetupPanel from "../components/SetupPanel.astro";
import QuizPanel from "../components/QuizPanel.astro";
import ResultsPanel from "../components/ResultsPanel.astro";
import AbandonDialog from "../components/AbandonDialog.astro";
import StudyGuideDialog from "../components/StudyGuideDialog.astro";
import ClaudeStudyGuideDialog from "../components/ClaudeStudyGuideDialog.astro";
import { CERTIFICATIONS, CERTIFICATION_DATA } from "../data/certifications";
---

<Layout
	title="Simulador de Certificaciones Técnicas · IA & Desarrollo"
	description="Practica exámenes y simulacros para GitHub Copilot GH-300 y Claude Certified Developer con explicaciones detalladas y fuentes oficiales."
	certifications={CERTIFICATIONS}
	questionsByCert={CERTIFICATION_DATA}
>
	<HeroSection />
	<CertificationSelector questionsByCert={CERTIFICATION_DATA} />
	<HistoryPanel />
	<SetupPanel />
	<QuizPanel />
	<ResultsPanel />
	<AbandonDialog />
	<StudyGuideDialog />
	<ClaudeStudyGuideDialog />
</Layout>
