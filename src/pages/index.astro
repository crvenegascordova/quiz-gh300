---
import Layout from "../components/Layout.astro";
import HeroSection from "../components/HeroSection.astro";
import HistoryPanel from "../components/HistoryPanel.astro";
import SetupPanel from "../components/SetupPanel.astro";
import QuizPanel from "../components/QuizPanel.astro";
import ResultsPanel from "../components/ResultsPanel.astro";
import AbandonDialog from "../components/AbandonDialog.astro";
import questions from "../data/questions.json";
import type { Question } from "../types/question";

const typedQuestions = questions as Question[];
const balotarios = [...new Set(typedQuestions.map((item) => item.balotario))].sort();
---

<Layout questions={typedQuestions}>
	<HeroSection />
	<HistoryPanel />
	<SetupPanel totalQuestions={typedQuestions.length} balotarios={balotarios} />
	<QuizPanel />
	<ResultsPanel />
	<AbandonDialog />
</Layout>
