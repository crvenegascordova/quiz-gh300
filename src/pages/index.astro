---
import questions from "../data/questions.json";

const serializedQuestions = JSON.stringify(questions);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Cuestionario de práctica para la certificación GitHub Copilot GH-300"
		/>
		<title>Práctica Microsoft Copilot GH 300</title>
	</head>
	<body>
		<main class="app-shell">
			<section class="hero" aria-labelledby="page-title">
				<div class="eyebrow">CERTIFICACIÓN GH-300</div>
				<h1 id="page-title">Práctica Microsoft Copilot GH 300</h1>
				<p class="hero-copy">
					Mide tu dominio en GitHub Copilot, con explicaciones y
					resultados por competencia.
				</p>
			</section>

			<div class="hero-actions">
				<button
					id="history-button"
					class="button button-secondary"
					type="button"
					aria-expanded="false"
					>Ver mis exámenes <span id="history-arrow">↓</span></button
				>
			</div>

			<section
				id="history-panel"
				class="panel history-panel hidden"
				aria-labelledby="history-title"
			>
				<div class="section-heading">
					<div>
						<span class="step-label">HISTORIAL LOCAL</span><h2
							id="history-title"
						>
							Tus exámenes realizados
						</h2>
					</div>
					<button
						id="history-refresh"
						class="button button-secondary"
						type="button">Actualizar</button
					>
				</div>
				<p class="history-intro">
					Tus resultados se guardan localmente en esta sesión.
				</p>
				<div id="history-list" class="history-list">
					<p class="empty-history">Cargando historial...</p>
				</div>
			</section>

			<section
				id="setup-panel"
				class="panel setup-panel"
				aria-labelledby="setup-title"
			>
				<div class="section-heading">
					<div>
						<span class="step-label">01 / CONFIGURACIÓN</span>
						<h2 id="setup-title">Diseña tu sesión</h2>
					</div>
					<span class="question-count">420 preguntas disponibles</span
					>
				</div>
				<div class="setup-grid">
					<label class="field">
						<span>Número de preguntas</span>
						<input
							id="question-limit"
							type="number"
							min="1"
							max="420"
							value="30"
							inputmode="numeric"
						/>
						<small>Entre 1 y 420 preguntas</small>
					</label>
					<label class="field">
						<span>Origen</span>
						<select id="balotario-select">
							<option value="all">Todos los balotarios</option>
							<option value="Balotario 1">Balotario 1</option>
							<option value="Balotario 2">Balotario 2</option>
							<option value="Balotario 3">Balotario 3</option>
							<option value="Balotario 4">Balotario 4</option>
							<option value="Balotario 5">Balotario 5</option>
							<option value="Balotario 6">Balotario 6</option>
						</select>
						<small
							>Las preguntas se seleccionan aleatoriamente</small
						>
					</label>
				</div>
				<button
					id="start-button"
					class="button button-primary"
					type="button">Comenzar examen <span>→</span></button
				>
			</section>

			<section
				id="quiz-panel"
				class="panel quiz-panel hidden"
				aria-live="polite"
			>
				<div class="quiz-topline">
					<div>
						<span class="step-label">EXAMEN EN CURSO</span><strong
							id="progress-label">Pregunta 1 de 30</strong
						>
					</div>
					<div class="flex items-center gap-2.5 flex-wrap">
						<span id="category-label" class="category-pill"
							>Categoría</span
						>
						<button
							id="abandon-button"
							class="abandon-button"
							type="button"
							title="Abandonar examen y volver a la configuración"
							>✕ Abandonar</button
						>
					</div>
				</div>
				<div class="progress-track">
					<span id="progress-bar"></span>
				</div>
				<div class="question-meta">
					<span id="balotario-label">Balotario 1</span><span
						id="question-number">01</span
					>
				</div>
				<h2 id="question-text" class="question-text"></h2>
				<div
					id="options"
					class="options"
					role="group"
					aria-label="Opciones de respuesta"
				>
				</div>
				<div id="review-box" class="review-box hidden"></div>
				<div class="quiz-actions">
					<button
						id="back-button"
						class="button button-secondary"
						type="button"
						><span class="button-icon-left">←</span> Salir y configurar</button
					>
					<button
						id="review-button"
						class="button button-secondary"
						type="button"
						disabled>Revisar respuesta</button
					>
					<button
						id="continue-button"
						class="button button-primary hidden"
						type="button"
						disabled>Continuar <span>→</span></button
					>
				</div>
			</section>

			<section
				id="results-panel"
				class="panel results-panel hidden"
				aria-labelledby="results-title"
			>
				<div class="step-label">RESULTADO FINAL</div>
				<h2 id="results-title">Tu sesión, en perspectiva.</h2>
				<div class="score-card">
					<span id="score-percent">0%</span><p id="score-summary">
						0 de 0 respuestas acertadas
					</p>
				</div>
				<div class="results-grid">
					<div>
						<span class="result-number correct" id="correct-count"
							>0</span
						><small>Acertadas</small>
					</div><div>
						<span
							class="result-number incorrect"
							id="incorrect-count">0</span
						><small>Incorrectas</small>
					</div>
				</div>
				<div class="category-results">
					<h3>Desempeño por competencia</h3><div
						id="category-results-list"
					>
					</div>
				</div>
				<button
					id="restart-button"
					class="button button-primary"
					type="button">Volver a practicar <span>↗</span></button
				>
			</section>

			<dialog
				id="abandon-dialog"
				class="modal-dialog"
				aria-labelledby="modal-title"
			>
				<div class="modal-content">
					<div class="modal-icon-wrapper">
						<span class="modal-icon">⚠️</span>
					</div>
					<h3 id="modal-title" class="modal-title">
						¿Abandonar examen en curso?
					</h3>
					<p class="modal-description">
						Si sales ahora, se descartará el progreso de esta sesión
						y regresarás a la pantalla de configuración inicial.
					</p>
					<div class="modal-actions">
						<button
							id="modal-cancel-btn"
							class="button button-secondary"
							type="button">Continuar examen</button
						>
						<button
							id="modal-confirm-btn"
							class="button button-danger"
							type="button">Sí, abandonar</button
						>
					</div>
				</div>
			</dialog>
		</main>

		<script define:vars={{ serializedQuestions }}>
			const allQuestions = JSON.parse(serializedQuestions);
			const state = {
				questions: [],
				current: 0,
				selected: [],
				reviewed: false,
				answers: [],
				selections: [],
			};
			const $ = (id) => document.getElementById(id);
			const setupPanel = $("setup-panel");
			const quizPanel = $("quiz-panel");
			const resultsPanel = $("results-panel");
			const historyPanel = $("history-panel");
			const reviewBox = $("review-box");

			async function loadHistory() {
				const response = await fetch("/api/attempts");
				const attempts = await response.json();
				$("history-list").innerHTML = attempts.length
					? `<div class="history-table-wrap"><table class="history-table"><thead><tr><th>Fecha</th><th>Balotario</th><th>Resultado</th><th>Preguntas</th><th>Acertadas</th><th>Incorrectas</th></tr></thead><tbody>${attempts
							.map((attempt) => {
								const date = new Date(
									attempt.created_at,
								).toLocaleString("es-ES", {
									dateStyle: "medium",
									timeStyle: "short",
								});
								return `<tr><td>${date}</td><td>${attempt.balotario}</td><td class="history-score">${attempt.score_percent}%</td><td>${attempt.total_questions}</td><td class="correct">${attempt.correct_answers}</td><td class="incorrect">${attempt.incorrect_answers}</td></tr>`;
							})
							.join("")}</tbody></table></div>`
					: '<p class="empty-history">Todavía no has completado ningún examen.</p>';
			}

			function toggleHistory() {
				const isHidden = historyPanel.classList.toggle("hidden");
				const historyArrow = $("history-arrow");
				if (historyArrow) {
					historyArrow.textContent = isHidden ? "↓" : "↑";
				}
				$("history-button")?.setAttribute(
					"aria-expanded",
					String(!isHidden),
				);
				if (!isHidden)
					loadHistory().catch(() => {
						$("history-list").innerHTML =
							'<p class="empty-history">No se pudo cargar el historial.</p>';
					});
			}

			function shuffle(items) {
				return [...items].sort(() => Math.random() - 0.5);
			}

			function startQuiz() {
				if (!historyPanel.classList.contains("hidden")) {
					historyPanel.classList.add("hidden");
					const historyArrow = $("history-arrow");
					if (historyArrow) historyArrow.textContent = "↓";
					$("history-button")?.setAttribute("aria-expanded", "false");
				}
				const selectedBalotario = $("balotario-select").value;
				const requestedLimit = Number($("question-limit").value);
				const pool =
					selectedBalotario === "all"
						? allQuestions
						: allQuestions.filter(
								(item) => item.balotario === selectedBalotario,
							);
				const limit = Math.min(
					Math.max(requestedLimit || 30, 1),
					pool.length,
				);
				state.questions = shuffle(pool).slice(0, limit);
				state.current = 0;
				state.selected = [];
				state.reviewed = false;
				state.answers = [];
				state.selections = [];
				setupPanel.classList.add("hidden");
				resultsPanel.classList.add("hidden");
				quizPanel.classList.remove("hidden");
				renderQuestion();
			}

			function updateBackButton() {
				const isFirst = state.current === 0;
				const disabled = state.selected.length > 0 || state.reviewed;
				const label = isFirst
					? "Salir y configurar"
					: "Pregunta anterior";
				$("back-button").disabled = disabled;
				$("back-button").innerHTML =
					`<span class="button-icon-left">←</span> ${label}`;
			}

			function renderQuestion() {
				const item = state.questions[state.current];
				state.selected = state.selections[state.current] || [];
				const isAnswered = state.answers[state.current] !== undefined;

				$("progress-label").textContent =
					`Pregunta ${state.current + 1} de ${state.questions.length}`;
				$("progress-bar").style.width =
					`${((state.current + 1) / state.questions.length) * 100}%`;
				$("category-label").textContent = item.category.name;
				$("balotario-label").textContent = item.balotario;
				$("question-number").textContent = String(item.number).padStart(
					2,
					"0",
				);
				$("question-text").textContent = item.question;

				if (isAnswered) {
					state.reviewed = true;
					$("options").innerHTML = item.options
						.map(
							(option) =>
								`<label class="option${state.selected.includes(option.id) ? " selected" : ""}" data-option="${option.id}"><input type="checkbox" value="${option.id}" aria-label="Seleccionar opción ${option.id}"${state.selected.includes(option.id) ? " checked" : ""} disabled /><span class="option-key">${option.id})</span><span class="option-text">${option.text}</span></label>`,
						)
						.join("");
					displayQuestionReview(item, state.selected);
					$("review-button").classList.add("hidden");
					$("continue-button").classList.remove("hidden");
					$("continue-button").disabled = false;
					updateBackButton();
				} else {
					state.reviewed = false;
					$("options").innerHTML = item.options
						.map(
							(option) =>
								`<label class="option${state.selected.includes(option.id) ? " selected" : ""}" data-option="${option.id}"><input type="checkbox" value="${option.id}" aria-label="Seleccionar opción ${option.id}"${state.selected.includes(option.id) ? " checked" : ""} /><span class="option-key">${option.id})</span><span class="option-text">${option.text}</span></label>`,
						)
						.join("");
					document
						.querySelectorAll(".option input")
						.forEach((checkbox) =>
							checkbox.addEventListener("change", () =>
								selectOption(checkbox.value, checkbox.checked),
							),
						);
					reviewBox.className = "review-box hidden";
					$("review-button").classList.remove("hidden");
					$("review-button").disabled = state.selected.length === 0;
					$("continue-button").classList.add("hidden");
					$("continue-button").disabled = true;
					updateBackButton();
				}
			}

			function selectOption(option, checked) {
				if (state.reviewed) return;
				state.selected = checked
					? Array.from(new Set([...state.selected, option]))
					: state.selected.filter((selected) => selected !== option);
				state.selections[state.current] = state.selected;
				document
					.querySelector(`.option[data-option="${option}"]`)
					?.classList.toggle("selected", checked);
				$("review-button").disabled = state.selected.length === 0;
				updateBackButton();
			}

			function getIncorrectRationale(opt, item) {
				const text = (opt.text || "").toLowerCase();
				const cat = item.category?.id || "";
				if (cat === "architecture" || cat === "privacy") {
					if (
						text.includes("compartir") ||
						text.includes("otros usuarios")
					) {
						return "El Microsoft Trust Center y las directrices de privacidad garantizan el aislamiento estricto del código del cliente: el código propietario nunca se comparte con terceros ni con otros usuarios u organizaciones.";
					}
					if (
						text.includes("almacena permanentemente") ||
						text.includes("almacena todo") ||
						text.includes("reentrenar")
					) {
						return "La documentación oficial de GitHub Copilot y el Microsoft Trust Center estipulan que las entradas de código no se almacenan permanentemente ni se utilizan para reentrenar modelos fundacionales en suscripciones comerciales o empresariales.";
					}
					if (
						text.includes("localmente") ||
						text.includes("sin transmitir") ||
						text.includes("sin enviar")
					) {
						return "Según la arquitectura oficial de GitHub Copilot, el procesamiento y la inferencia del modelo se realizan mediante un proxy seguro en la nube; no se ejecuta de forma puramente local en el IDE.";
					}
					return `De acuerdo con las directrices de privacidad y arquitectura de Microsoft Learn y GitHub Docs (${item.source?.title || "GitHub Docs"}), esta opción describe un tratamiento de retención o flujo no conforme con las salvaguardas oficiales.`;
				}
				if (
					text.includes("individual") ||
					text.includes("business") ||
					text.includes("enterprise")
				) {
					return `En la documentación de planes de GitHub Copilot (Microsoft Learn / GitHub Docs), la capacidad o requisito de gobernanza indicado en este escenario no coincide con las funciones del plan seleccionado.`;
				}
				if (cat === "prompting") {
					if (
						text.includes("breve") ||
						text.includes("genérico") ||
						text.includes("sin detalles") ||
						text.includes("sin contexto")
					) {
						return "Las guías de estudio oficial de Microsoft Learn para GH-300 indican que los prompts ambiguos o sin restricciones degradan la calidad del código. Se debe aportar contexto, restricciones y ejemplos verificables.";
					}
					return `Según las directrices de ingeniería de prompts de GitHub Copilot y Microsoft Learn, esta opción no optimiza el contexto ni sigue los principios recomendados para guiar las sugerencias del modelo.`;
				}
				if (cat === "responsible") {
					if (
						text.includes("asumir") ||
						text.includes("siempre seguro") ||
						text.includes("sin revisar") ||
						text.includes("sin validar")
					) {
						return "Los principios de IA Responsable de Microsoft determinan que el desarrollador permanece en control y debe validar, probar y auditar cada sugerencia antes de su puesta en producción.";
					}
					return `El estándar de Uso Responsable de Microsoft y GitHub Docs estipula que la IA no garantiza infalibilidad por sí sola y requiere supervisión activa del equipo de desarrollo.`;
				}
				if (cat === "features" || cat === "productivity") {
					return `Según la documentación técnica oficial de GitHub Copilot (${item.source?.title || "Microsoft Learn"}), esta opción describe un alcance, comando o herramienta que no corresponde a los requisitos formulados en la pregunta.`;
				}
				return `De acuerdo con la documentación oficial de Microsoft Learn y GitHub Copilot (${item.source?.title || "GitHub Docs"}), la opción ${opt.id} no satisface los criterios técnicos requeridos para este escenario.`;
			}

			function displayQuestionReview(item, selectedIds) {
				const correctAnswers = item.correctAnswer
					.split(/\s*(?:y|,)\s*/)
					.map((opt) => opt.trim())
					.filter(Boolean);
				const correct =
					selectedIds.length === correctAnswers.length &&
					selectedIds.every((option) =>
						correctAnswers.includes(option),
					);
				document.querySelectorAll(".option").forEach((option) => {
					const isCorrect = correctAnswers.includes(
						option.dataset.option,
					);
					option.classList.toggle("correct", isCorrect);
					option.classList.toggle(
						"incorrect",
						selectedIds.includes(option.dataset.option) &&
							!isCorrect,
					);
					option.querySelector("input").disabled = true;
				});

				if (correct) {
					reviewBox.className = "review-box review-correct";
					reviewBox.innerHTML = `
						<div class="review-status-correct"><strong>✓ Respuesta correcta</strong></div>
						<p>${item.explanation}</p>
						<a href="${item.source.url}" target="_blank" rel="noreferrer">Consultar fuente oficial: ${item.source.title} ↗</a>
					`;
				} else {
					const incorrectSelected = selectedIds
						.filter((id) => !correctAnswers.includes(id))
						.map((id) => item.options.find((opt) => opt.id === id))
						.filter(Boolean);
					const missingCorrect = correctAnswers
						.filter((id) => !selectedIds.includes(id))
						.map((id) => item.options.find((opt) => opt.id === id))
						.filter(Boolean);

					let html = `
						<div class="review-status-incorrect"><strong>✕ Respuesta incorrecta</strong></div>
					`;

					if (incorrectSelected.length > 0) {
						html += `
							<div class="incorrect-reasons">
								<span class="section-tag">¿Por qué no es correcta tu elección? (Fuentes oficiales Microsoft / GitHub Docs):</span>
								${incorrectSelected
									.map(
										(opt) => `
									<div class="incorrect-card">
										<div class="incorrect-card-title">Opción seleccionada ${opt.id}: "${opt.text}"</div>
										<div class="incorrect-card-reason">${getIncorrectRationale(opt, item)}</div>
									</div>
								`,
									)
									.join("")}
							</div>
						`;
					}

					if (missingCorrect.length > 0) {
						html += `
							<div class="missing-warning">
								<strong>Faltó seleccionar:</strong> ${missingCorrect.map((m) => `Opción ${m.id} ("${m.text}")`).join(", ")}
							</div>
						`;
					}

					html += `
						<div class="correct-resolution">
							<span class="section-tag text-[#3fb950]">Fundamentación oficial (Respuesta correcta: ${correctAnswers.join(", ")}):</span>
							<p>${item.explanation}</p>
							<a href="${item.source.url}" target="_blank" rel="noreferrer">Consultar fuente oficial: ${item.source.title} ↗</a>
						</div>
					`;

					reviewBox.className = "review-box review-incorrect";
					reviewBox.innerHTML = html;
				}
				return correct;
			}

			function reviewAnswer() {
				if (state.selected.length === 0 || state.reviewed) return;
				const item = state.questions[state.current];
				state.reviewed = true;
				const correct = displayQuestionReview(item, state.selected);
				state.answers[state.current] = {
					correct,
					category: item.category.id,
				};
				$("review-button").classList.add("hidden");
				$("continue-button").classList.remove("hidden");
				$("continue-button").disabled = false;
				updateBackButton();
			}

			function scrollToQuestionTop() {
				const panel = $("quiz-panel");
				if (!panel) return;
				try {
					panel.scrollIntoView({
						behavior: "smooth",
						block: "start",
					});
				} catch {
					window.scrollTo({
						top: panel.offsetTop - 16,
						behavior: "smooth",
					});
				}
			}

			function continueQuiz() {
				if (!state.reviewed) return;
				if (state.current < state.questions.length - 1) {
					state.current += 1;
					renderQuestion();
					scrollToQuestionTop();
				} else showResults();
			}

			function exitQuiz() {
				state.questions = [];
				state.current = 0;
				state.selected = [];
				state.reviewed = false;
				state.answers = [];
				state.selections = [];
				quizPanel.classList.add("hidden");
				resultsPanel.classList.add("hidden");
				setupPanel.classList.remove("hidden");
			}

			function goBack() {
				if (state.selected.length > 0 || state.reviewed) return;
				if (state.current === 0) {
					exitQuiz();
					return;
				}
				state.current -= 1;
				renderQuestion();
				scrollToQuestionTop();
			}

			async function saveAttempt(correct, total, categories) {
				const categorySummary = categories.map((id) => {
					const categoryQuestions = state.questions.filter(
						(item) => item.category.id === id,
					);
					const categoryCorrect = categoryQuestions.filter(
						(item) =>
							state.answers[state.questions.indexOf(item)]
								?.correct,
					).length;
					return {
						name: categoryQuestions[0].category.name,
						correct: categoryCorrect,
						total: categoryQuestions.length,
					};
				});
				await fetch("/api/attempts", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						balotario:
							$("balotario-select").value === "all"
								? "Todos los balotarios"
								: $("balotario-select").value,
						totalQuestions: total,
						correctAnswers: correct,
						incorrectAnswers: total - correct,
						scorePercent: Math.round((correct / total) * 100),
						categorySummary,
					}),
				});
			}

			function showResults() {
				const correct = state.answers.filter(
					(answer) => answer?.correct,
				).length;
				const total = state.questions.length;
				const categories = [
					...new Set(state.questions.map((item) => item.category.id)),
				];
				$("score-percent").textContent =
					`${Math.round((correct / total) * 100)}%`;
				$("score-summary").textContent =
					`${correct} de ${total} respuestas acertadas`;
				$("correct-count").textContent = correct;
				$("incorrect-count").textContent = total - correct;
				$("category-results-list").innerHTML = categories
					.map((id) => {
						const categoryQuestions = state.questions.filter(
							(item) => item.category.id === id,
						);
						const categoryCorrect = categoryQuestions.filter(
							(item, index) =>
								state.answers[state.questions.indexOf(item)]
									?.correct,
						).length;
						const category = categoryQuestions[0].category;
						return `<div class="category-result"><div><strong>${category.name}</strong><span>${categoryCorrect}/${categoryQuestions.length} acertadas</span></div><div class="category-track"><span style="width:${(categoryCorrect / categoryQuestions.length) * 100}%"></span></div><b>${Math.round((categoryCorrect / categoryQuestions.length) * 100)}%</b></div>`;
					})
					.join("");
				saveAttempt(correct, total, categories).catch(() => {});
				quizPanel.classList.add("hidden");
				resultsPanel.classList.remove("hidden");
			}

			function restart() {
				resultsPanel.classList.add("hidden");
				setupPanel.classList.remove("hidden");
			}
			$("history-button").addEventListener("click", toggleHistory);
			$("history-refresh").addEventListener("click", () => loadHistory());
			$("start-button").addEventListener("click", startQuiz);
			$("back-button").addEventListener("click", goBack);
			const abandonDialog = $("abandon-dialog");
			$("abandon-button").addEventListener("click", () => {
				abandonDialog.showModal();
			});
			$("modal-cancel-btn").addEventListener("click", () => {
				abandonDialog.close();
			});
			$("modal-confirm-btn").addEventListener("click", () => {
				abandonDialog.close();
				exitQuiz();
			});
			abandonDialog.addEventListener("click", (e) => {
				const rect = abandonDialog.getBoundingClientRect();
				const isInDialog =
					rect.top <= e.clientY &&
					e.clientY <= rect.top + rect.height &&
					rect.left <= e.clientX &&
					e.clientX <= rect.left + rect.width;
				if (!isInDialog) {
					abandonDialog.close();
				}
			});
			$("review-button").addEventListener("click", reviewAnswer);
			$("continue-button").addEventListener("click", continueQuiz);
			$("restart-button").addEventListener("click", restart);
		</script>
	</body>
</html>

